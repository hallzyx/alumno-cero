# Copia este archivo a .env y completa tu API key de OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Modelo de voz -> texto (dictado). Debe aceptar audio de entrada.
OPENROUTER_VOICE_MODEL=google/gemini-2.5-flash

# LLM de escritura: Cero redacta con él lo que entendió de tu explicación.
OPENROUTER_WRITING_MODEL=anthropic/claude-sonnet-4.5

# Opcionales
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Alumno Cero

# Base de datos MySQL/MariaDB (se crea sola la base y las tablas al primer uso)
DB_HOST=127.0.0.1
DB_PORT=33065
DB_USER=root
DB_PASSWORD=
DB_NAME=alumno_cero

# Docker / Dokploy (docker-compose.yml): la app se conecta a la base `db` del propio compose.
# DB_PASSWORD es obligatoria ahí (es la clave root de MariaDB). DB_HOST/DB_PORT/DB_USER los fija el compose.
# COOKIE_SECURE=1 (por defecto en el compose) exige HTTPS; usa 0 solo si pruebas por http.
# COOKIE_SECURE=1
